# =========================================================
# Postgres (usado pelo serviço db e pelo backend)
# =========================================================
POSTGRES_USER=moveonboard
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=move_on_board

# =========================================================
# Backend
# =========================================================
# JWT — gere uma chave forte! Exemplo:
#   openssl rand -hex 48
SECRET_KEY=GERAR_UMA_CHAVE_LONGA_E_ALEATORIA_AQUI_MIN_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

APP_ENV=production
APP_DEBUG=false

# OBS: DATABASE_URL é montado automaticamente no docker-compose
# a partir das variáveis POSTGRES_* acima — não precisa setar aqui.
